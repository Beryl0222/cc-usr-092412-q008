{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "医者荣誉贡献档案领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PROFILE_REGISTERED",
        "HONOR_CASE_OPENED",
        "CONTRIBUTION_NOMINATED",
        "SAME_NAME_HINT_RECORDED",
        "FACT_CONFIRMED",
        "CONSENT_GRANTED",
        "CONSENT_VERSION_FROZEN",
        "CONSENT_WITHDRAWN",
        "EVIDENCE_MASKED",
        "QUALIFICATION_CORRECTED",
        "OVERLAP_FLAGGED",
        "OVERLAP_RESOLVED",
        "OMISSION_FLAGGED",
        "OMISSION_RESOLVED",
        "DISPUTE_FILED",
        "DISPUTE_RESOLVED",
        "ROSTER_SIGNED",
        "SIGNING_HELD",
        "HELD_SIGNING_RESOLVED",
        "MATERIAL_DRAFTED",
        "MATERIAL_ACTION_REQUIRED",
        "STORY_RELEASED",
        "MATERIAL_REPLACED",
        "MATERIAL_CORRECTED",
        "MATERIAL_RETRACTED",
        "ARCHIVE_SEALED",
        "CONTRIBUTION_ATTESTED",
        "ATTRIBUTION_CORRECTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "nominee_profile",
        "honor_case",
        "contribution_record",
        "consent_grant",
        "public_story"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
